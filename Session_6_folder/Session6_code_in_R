# 2.5 Plot allele frequency across all loci
    allele_frequencies = apply(genotypes, 1, mean, na.rm=TRUE)/2    # quantifiying the allele frequency normalized mean; selecting all genotypes allele codes in row 1 and removing all NA values. Data set found under 'Values' in environment (top right quarter) on R.
        plot_data = tibble(allele_frequencies)                      # converting the vectors into tibble and storing it into a column in the 'plot_data' data frame. Data set found under 'Data' in environment (top right quarter) on R.

    ggplot(plot_data, aes(allele_frequencies)) + geom_histogram()   # plotting a histogram with the normalized mean allele frequencies in x axis and count in y axis
                    # There are 504 samples across row 1 with an average value of 0.16 thus more homozygous alleles for reference allele (0) than homozygous alleles for alternative allele (2). 
                    # The total sum of the row is 80 which when divided by 2 equates to 40 samples of (2) and 464 samples of (0). 

