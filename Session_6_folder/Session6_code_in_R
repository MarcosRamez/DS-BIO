# GENOTYPE-PHENOTYPE ASSOCIATION
# 3.1 Plot the association between one genotype and the phenotype 
phenotypes$one_geno = as.numeric(one_geno)              # Converting 'one_geno' into numeric form and assigning it to the 'one_geno' column within the 'phenotypes' data frame which is accessed using the $. 
                                                             # 'Height' column already exists in the phenotypes data frame set so no need to do this.
ggplot(phenotypes, aes(x=one_geno, y=Height)) +         # Creates a scatter plot using 'ggplot', with 'one_geno' on the x-axis and 'Height' on the y-axis from the 'phenotypes' dataset using aesthetic mapping.
   geom_jitter(width=0.2) +                                # Adds jittered points to the plot with a horizontal offset (width = 0.2) to reduce overplotting of points.
   geom_smooth(method='lm')                                # Adds a linear regression line ('lm') to show the trend between the genotype ('one_geno') and the phenotype ('Height').

