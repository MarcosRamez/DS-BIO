# GENOME-WIDE ASSOCIATION STUDIES (GWAS)  
# 5.1 We create a sample function to carry out an association test across all genotypes 
    GWAS_sample_function = function(inputA, inputB){                       # Sample 'GWAS_sample_function' that takes two inputs: 'inputA' and 'inputB'
      step1 = inputA^2 + inputB                                            # Step 1: Calculate the square of inputA and adds inputB to it.
      step1 + 5                                                            # Step 2: Add 5 to the result of step1
    }
    GWAS_sample_function(3,3)                                              # Example of GWAS_sample_function(3,3) in the console which is 17. 

# 5.2 GWAS; Apply association test to every genotype
     association_test = function(geno, pheno) {                                # We are carrying out a function including the 'geno' and 'pheno' data sets. 
        geno_numeric = as.numeric(geno)                                        # as.numeric function converts all quantitative values in genotypes dataframe. Qualitative values listed as NA are not included.
        test_result = cor.test(geno_numeric, pheno)                            # performing a Pearson correlation test between 'geno' and 'pheno'. 
        test_result$p.value                                                    # we can retrieve the p-value from the correlation test performed above 
      }
      print (test_result)                                                      # prints a summary of the correlation test result above 
      print (test_result$p.value)                                              # prints the p-value 

# 5.3 Plot the chromosome position against –log10(p value) 
    get_p_values = function(genos, pheno){                                     # calculating the p values from the 'geno' and 'pheno' data sets and naming this function 'get_p_values'
      apply(genos, 1, association_test , pheno)                                    # applyingthe association test function to each row as denoted by 1 and getting a p=value
    }                                                                              
    pvalue = get_p_values(genotypes, phenotypes$Height)                        # calling/executing the function above, but restricted to the genotypes row and phenotypes height. 
    map = mutate(map, pvalue= pvalue)                                          # we add a new column 'p.value' to the map dataset using the mutate function 
    ggplot(map, aes(x=Position, y=-log10(pvalue))) + geom_point()              # creating a scatterplot where the x-axis the position and the y-axis is pvalue 
