# GENOTYPE-PHENOTYPE ASSOCIATION
# 3.1 Plot the association between one genotype and the phenotype 
    phenotypes$one_geno = as.numeric(one_geno)              # Converting 'one_geno' into numeric form and assigning it to the 'one_geno' column within the 'phenotypes' data frame which is added using the $. If you open 'phenotypes' data you will see the new column.
                                                                # 'Height' column already exists in the phenotypes data frame set so no need to do this for height. 
    ggplot(phenotypes, aes(x=one_geno, y=Height)) +         # Using aesthetic mapping we create a scatter plot using 'ggplot', with 'one_geno' on the x-axis and 'Height' on the y-axis from the 'phenotypes' dataset. 
       geom_jitter(width=0.2) +                                 # Adds jittered points to the plot with a horizontal offset (width = 0.2) to reduce overplotting of points.
       geom_smooth(method='lm')                                 # Adds a linear regression line ('lm') to show the trend between the genotype ('one_geno') and the phenotype ('Height').

############################################# 
# 4.1 Statistical association between one genotype and the phenotype
    corTestResult = cor.test(phenotypes$Height, phenotypes$one_geno)    # Performs a correlation test between the 'Height' and 'one_geno' columns in the phenotypes data frame. Results stored in 'corTestResult'. Data set found under 'Data' in environment (top right quarter) on R.
    corTestResult$p.value                                               # Assessing the p-value from the correlation test result run above.
                                                                            # p-value should be 0.520511 thus null hypothesis; not statistically significant. 
