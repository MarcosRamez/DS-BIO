example_function = function(inputA, inputB){                       # Define the function `example_function` that takes two inputs: `inputA` and `inputB`
  step1 = inputA^2 + inputB                                            # Step 1: Calculate the square of inputA and add inputB to it.
  step1 + 5                                                            # Step 2: Add 5 to the result of step1
}
example_function(3,3)                                              # Example of calling the function example_function(3, 3) in the console 

association_test = function(inputA, inputB){                                        # We define the association test function which will perform a correlation test between inputA and inputB
  test_result = cor.test(inputA, inputB)                                                # Step 1: Perform a correlation test between the two input variables (inputA and inputB).
  test_result$p.value                                                                   # Step 2: Extract the p-value from the correlation test result (assocaiton).
}
association_test(one_geno, phenotypes$Height)                                       # The function `association_test` is called using `one_geno` and `phenotypes$Height` as inputs.
map$pvalues= apply(genotypes, 1, association_test,inputB=phenotypes$Height)         # The p-values from the `association_test` of each row 1 of `genotypes`, are stored in the `map$pvalues` vector
ggplot(map, aes(x=Position, y=-log10(pvalues))) + geom_point()                      # Scatter plot includes negative log-transformed p-values for the genome-wide association studies (GWAS) to visualize the significance.



