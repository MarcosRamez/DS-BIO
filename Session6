# 2.1 Using the ggplot2 sub-package from tidyverse (pplots and visualizations), we use ggplot function 
    # 2.1a     Histogram of the phenotypes dataset
        ggplot(phenotypes, aes(x=Height)) + geom_histogram()  # using the ggplot function, we map height (x-axis) using histogram by binning the data count (y-axis) into discrete values.  
    # 2.1b     Histogram of the Map dataset 
        ggplot(map, aes(x=Position)) + geom_histogram()       # using the ggplot function, we map chromosomal positions (x-axis) and plot a histogram by binning the data count (y-axis) into discrete values.

# 2.2 Pick a locus: Converting column datasets into a vector  
    one_geno = as.numeric(genotypes[2,])                  # as.numeric function converts all quantitative values along the row. Qualitative values are listed as NA.
                                                          # extracting row 2 from genotypes dataset and all columns of the genotypes dataframe
# 2.3 Determining the allele frequency 
    mean(one_geno)                                        # finding the mean of all the row 
         ?mean                                            # R Documentation syntax method to open 'arithmetic mean' definition in the 'Help' view (bottom right quarter)  
         one_geno                                         # will display the one_geno value list in the 'Console' view Console (bottom left quarter) of R                                   
    mean(one_geno, na.rm=TRUE)/2                          # computing the mean of one_geno and dividing the results by 2 to scale down the results. na.rm=TRUE ignores NA qualitative values.  

# 2.4 Allele frequency across all loci 
    apply(genotypes, 1, mean, na.rm=TRUE)/2               # vector representing the normalized mean genotype for each sample population

# 2.5 Plot allele frequency across all loci
    allele_frequencies = apply(genotypes, 1, mean, na.rm=TRUE)/2    # quantifiying the allele frequency; selecting all genotypes allele codes in row 1 and removing all NA values.
        plot_data = tibble(allele_frequencies)                      # plotting the result using tibble function data frame 

    ggplot(plot_data, aes(allele_frequencies)) + geom_histogram()   # plotting a histogram with allele frequencies in x axis and allele count in y axis
                    # There are 504 samples across row 1 with an average value of 0.16 thus more homozygous alleles for reference allele (0) than homozygous alleles for alternative allele (2). 
                    # The total sum of the row is 80 which when divided by 2 equates to 40 samples of (2) and 464 samples of (0). 

